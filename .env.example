# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# JWT密钥 (请替换为你自己的随机字符串)
JWT_SECRET=your-super-secret-jwt-key-change-this

# 管理员账号 (首次启动时自动创建)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 定时签到时间 (cron表达式, 默认每天早上8:05)
CRON_SCHEDULE=5 8 * * *

# 签到随机延迟 (秒, 防止被检测)
CHECKIN_DELAY_MIN=10
CHECKIN_DELAY_MAX=120

# 数据库路径
DB_PATH=./data/database.db
